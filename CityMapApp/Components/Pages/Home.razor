@page "/"
@rendermode InteractiveServer
@inject HttpClient Http
@inject NavigationManager Navigation

<PageTitle>Thrive St. George | Community Map</PageTitle>

<section class="hero-home">
    <div id="add-location" class="location-section">
        <div class="section-intro">
            <p class="eyebrow">THRIVE ST. GEORGE COMMUNITY MAP</p>
            <h1>Where do you call <span>home?</span></h1>
            <p>Thrive brings curious people together in Southern Utah. Add your hometown and help us see just how far our community reaches.</p>
            <a class="text-link" href="map">See our growing community <span aria-hidden="true">&rarr;</span></a>
        </div>
        <div class="form-wrap">
            <div class="form-heading"><div><p class="eyebrow">ADD YOUR PIN</p><h2>Put your city on the map.</h2></div></div>
            @if (_loading)
            {
                <p class="status-note">Checking your location...</p>
            }
            else if (_hasSubmitted)
            {
                <div class="success-note"><strong>You’re on the map.</strong><span>Thank you for helping our community take shape.</span><a href="map">View the community map</a></div>
            }
            else
            {
                <EditForm Model="_request" FormName="request" OnSubmit="SubmitAsync" class="submission-form">
                    <DataAnnotationsValidator />
                    <div class="field-row">
                        <div class="field"><label for="city">City</label><InputText id="city" @bind-Value="_request.City" placeholder="City" /><ValidationMessage For="() => _request.City" /></div>
                        <div class="field state-field"><label for="state">State</label><InputSelect id="state" @bind-Value="_request.State"><option value="">Select</option>@foreach (var s in _states){
                            <option value="@s">@s</option>
                        }
                    </InputSelect><ValidationMessage For="() => _request.State" /></div>
                </div>
                <div class="field"><label for="name">Name <span>optional — shared only if you include an email</span></label><InputText id="name" @bind-Value="_request.Name" placeholder="Your name" /><ValidationMessage For="() => _request.Name" /></div>
                <div class="field"><label for="email">Email <span>optional</span></label><InputText id="email" type="email" @bind-Value="_request.EmailAddress" placeholder="you@example.com" /><ValidationMessage For="() => _request.EmailAddress" /></div>
                <button type="submit" class="submit-button" disabled="@_submitting">@(_submitting ? "Adding location..." : "Place me on the map")</button>
            </EditForm>
            @if (!string.IsNullOrWhiteSpace(_message))
            {
                <p class="error-note">@_message</p>
            }
        }
    </div>
</div>
</section>

<section id="about" class="story-band"><div><p class="eyebrow">CONNECTED BY CURIOSITY</p><h2>Every pin tells a story.</h2></div><p>From lifelong locals to brand-new neighbors, our map celebrates the people who gather, question, grow, and thrive together in Southern Utah.</p></section>
<footer>
    <a class="footer-brand" href="" aria-label="Thrive St. George home">
        <img src="images/thrive-st-george-logo.png" alt="Thrive St. George" />
    </a>
    <nav aria-label="Footer navigation"><a href="">Home</a><a href="#add-location">Add location</a><a href="map">Map</a></nav>
    <p>A community built to question, connect, and thrive.<br />&copy; 2026 Thrive St. George</p>
</footer>